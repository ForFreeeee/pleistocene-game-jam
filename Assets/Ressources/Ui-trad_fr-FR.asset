  m_Name: Ui-trad_fr-FR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr-FR
  m_SharedData: {fileID: 11400000, guid: 1ecb82d894e13f9488f56ed2d6617a22, type: 2}
  m_Metadata:
